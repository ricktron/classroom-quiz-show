{
  "name": "classroom-quiz-show",
  "private": true,
  "version": "0.1.0",
  "productName": "Classroom Quiz Show",
  "main": "out/main/main.cjs",
  "type": "module",
  "description": "Classroom Quiz Show — a local-first, reusable classroom game-show engine (Slice 1 foundation).",
  "license": "MIT",
  "author": "Classroom Quiz Show contributors",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build:desktop:renderer && npm run build:desktop:main",
    "build:desktop:renderer": "vite build --mode desktop",
    "build:desktop:main": "vite build --config vite.desktop-main.config.ts",
    "desktop": "npm run build:desktop && electron .",
    "package:desktop": "npm run build:desktop && electron-builder --publish never",
    "package:desktop:mac": "electron-builder --mac --publish never",
    "package:desktop:win": "electron-builder --win --publish never",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build:desktop && playwright test -c tests/desktop/playwright.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:run",
    "verify:all": "npm run lint && npm run typecheck && npm run test:run && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
